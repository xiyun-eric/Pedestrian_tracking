# ============================================================
data/MOT17/*/img1/
data/MOT17/*/det/
data/MOT17/*/gt/

# 自定义数据集图片和视频
data/custom/images/
data/custom/videos/
data/yolo_custom/

# SFT 数据文件 (可由 build_sft_data.py 重新生成)
data/*.jsonl

